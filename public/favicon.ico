<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <!-- Background Gradient (Rich Emerald Green to Deep Forest) -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#064e3b" />
      <stop offset="50%" stop-color="#047857" />
      <stop offset="100%" stop-color="#022c22" />
    </linearGradient>

    <!-- Gold Accent Gradient -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="35%" stop-color="#f59e0b" />
      <stop offset="70%" stop-color="#d97706" />
      <stop offset="100%" stop-color="#78350f" />
    </linearGradient>

    <!-- Notebook Leather Cover Gradient (Deep Navy Blue) -->
    <linearGradient id="coverGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>

    <!-- Page Sheets Gradient -->
    <linearGradient id="pageGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fefce8" />
      <stop offset="100%" stop-color="#fef3c7" />
    </linearGradient>

    <!-- Bright Emerald Glow -->
    <linearGradient id="glowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#34d399" />
      <stop offset="100%" stop-color="#059669" />
    </linearGradient>

    <!-- Drop Shadow Filter -->
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#000000" flood-opacity="0.45"/>
    </filter>
    
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="0" stdDeviation="10" flood-color="#10b981" flood-opacity="0.6"/>
    </filter>
  </defs>

  <!-- Main App Icon Container (Squircle) -->
  <rect x="16" y="16" width="480" height="480" rx="108" fill="url(#bgGrad)" stroke="url(#goldGrad)" stroke-width="6" />

  <!-- Subtle Inner Stitching Accent -->
  <rect x="36" y="36" width="440" height="440" rx="88" fill="none" stroke="url(#goldGrad)" stroke-width="2" stroke-dasharray="10 8" opacity="0.35" />

  <!-- Main Digital Ledger Notebook -->
  <g filter="url(#shadow)">
    <!-- Base Notebook Cover (Deep Navy) -->
    <rect x="130" y="100" width="270" height="312" rx="20" fill="url(#coverGrad)" stroke="url(#goldGrad)" stroke-width="4" />

    <!-- Lined Paper Pages (Slightly Offset for 3D Layering) -->
    <rect x="145" y="112" width="245" height="288" rx="12" fill="url(#pageGrad)" stroke="#cbd5e1" stroke-width="1.5" />

    <!-- Notebook Page Lines (Cahier Ligné) -->
    <line x1="165" y1="160" x2="365" y2="160" stroke="#93c5fd" stroke-width="2" opacity="0.6" />
    <line x1="165" y1="200" x2="365" y2="200" stroke="#93c5fd" stroke-width="2" opacity="0.6" />
    <line x1="165" y1="240" x2="365" y2="240" stroke="#93c5fd" stroke-width="2" opacity="0.6" />
    <line x1="165" y1="280" x2="365" y2="280" stroke="#93c5fd" stroke-width="2" opacity="0.6" />
    <line x1="165" y1="320" x2="365" y2="320" stroke="#93c5fd" stroke-width="2" opacity="0.6" />
    <line x1="165" y1="360" x2="365" y2="360" stroke="#93c5fd" stroke-width="2" opacity="0.6" />

    <!-- Red Margin Line (Margin Cahier d'école) -->
    <line x1="200" y1="112" x2="200" y2="400" stroke="#f43f5e" stroke-width="2" opacity="0.7" />

    <!-- Gold Ribbon Bookmark -->
    <path d="M320 100 V180 L338 165 L356 180 V100 Z" fill="url(#goldGrad)" opacity="0.95" filter="url(#shadow)" />

    <!-- Smart Validation Checkmark Circle Emblem (Caisse Intelligente) -->
    <circle cx="285" cy="256" r="64" fill="url(#glowGrad)" stroke="url(#goldGrad)" stroke-width="4" filter="url(#glow)" />
    <!-- Checkmark icon -->
    <path d="M255 258 L275 278 L318 232" fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" />

    <!-- AI Sparkle 1 -->
    <path d="M370 140 Q370 155 385 155 Q370 155 370 170 Q370 155 355 155 Q370 155 370 140 Z" fill="url(#goldGrad)" />
    <!-- AI Sparkle 2 -->
    <path d="M160 330 Q160 340 170 340 Q160 340 160 350 Q160 340 150 340 Q160 340 160 330 Z" fill="url(#goldGrad)" />
  </g>

  <!-- Metallic Gold Spiral Rings (Binding on Left) -->
  <g filter="url(#shadow)">
    <!-- Ring 1 -->
    <rect x="110" y="130" width="42" height="14" rx="7" fill="url(#goldGrad)" />
    <!-- Ring 2 -->
    <rect x="110" y="190" width="42" height="14" rx="7" fill="url(#goldGrad)" />
    <!-- Ring 3 -->
    <rect x="110" y="250" width="42" height="14" rx="7" fill="url(#goldGrad)" />
    <!-- Ring 4 -->
    <rect x="110" y="310" width="42" height="14" rx="7" fill="url(#goldGrad)" />
    <!-- Ring 5 -->
    <rect x="110" y="370" width="42" height="14" rx="7" fill="url(#goldGrad)" />
  </g>
</svg>
