# ==========================================
# ☁️ CumuluShop — Variables d'Environnement
# ==========================================

# 1. 🤖 Clé API NVIDIA NIM (Nemotron Reasoning 30B & Llama 3.1)
# Obtenez votre clé gratuite sur https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-nvidia-nim-api-key-here

# 2. 🗄️ Supabase (Base de Données & Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Clé secrète Service Role (Optionnelle, pour administration)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. 🌐 Configuration de l'Application
# Local : http://localhost:3000 | Production : https://votre-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
